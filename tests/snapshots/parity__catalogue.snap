                  "to": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "move"
                  }
                },
                "required": [
                  "op",
                  "from",
                  "to"
                ]
              },
              {
                "description": "Delete a file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "delete"
                  }
                },
                "required": [
                  "op",
                  "path"
                ]
              }
            ]
          },
          "Splice": {
            "type": "object",
            "properties": {
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ]
          },
          "Warning": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ]
          }
        }
      }
    },
    {
      "name": "list_attachments",
      "kind": "query",
      "description": "List Attachments: a Page's own, or all of them in a Space, path prefix or the Wiki.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ListAttachmentsInput",
        "description": "List Attachments: one Page's own, or everything in a part of the Wiki.",
        "type": "object",
        "properties": {
          "page": {
            "description": "Only this Page's own Attachments (its folder, not its Child Pages').",
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "description": "Everything in this part of the Wiki (not with `page`).",
            "$ref": "#/$defs/Scope"
          }
        },
        "additionalProperties": false,
        "$defs": {
          "Scope": {
            "description": "Which part of the Wiki a query covers (operations.md `Scope`).",
            "type": "object",
            "properties": {
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ListAttachmentsOutput",
        "type": "object",
        "properties": {
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/AttachmentRow"
            }
          }
        },
        "required": [
          "attachments"
        ],
        "$defs": {
          "AttachmentRow": {
            "type": "object",
            "properties": {
              "path": {
                "description": "Path from the Wiki root, extension included.",
                "type": "string"
              },
              "size": {
                "description": "Bytes.",
                "type": "integer",
                "format": "int64"
              },
              "modified": {
                "description": "Last modified, milliseconds since the Unix epoch.",
                "type": "integer",
                "format": "int64"
              }
            },
            "required": [
              "path",
              "size",
              "modified"
            ]
          }
        }
      }
    },
    {
      "name": "read_attachment",
      "kind": "query",
      "description": "Read an Attachment: its content as base64, or its absolute local path.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ReadAttachmentInput",
        "description": "Read an Attachment's content, or where it is on disk.",
        "type": "object",
        "properties": {
          "path": {
            "description": "Path from the Wiki root, e.g. `eng/rust/diagram.png`.",
            "type": "string"
          },
          "as": {
            "description": "`bytes` (default) or `local_path`.",
            "$ref": "#/$defs/ReadAs"
          }
        },
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "$defs": {
          "ReadAs": {
            "oneOf": [
              {
                "description": "The content, base64-encoded.",
                "type": "string",
                "const": "bytes"
              },
              {
                "description": "The file's absolute path (Interfaces with local file access only).",
                "type": "string",
                "const": "local_path"
              }
            ]
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ReadAttachmentOutput",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "version": {
            "type": "string"
          },
          "base64": {
            "description": "With `as: bytes`.",
            "type": [
              "string",
              "null"
            ]
          },
          "local_path": {
            "description": "With `as: local_path`: the absolute path.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "size",
          "version"
        ]
      }
    },
    {
      "name": "move_attachment",
      "kind": "mutation",
      "description": "Move or rename an Attachment, rewriting every Link to it.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "MoveAttachmentInput",
        "description": "Move or rename an Attachment, rewriting every Link to it.",
        "type": "object",
        "properties": {
          "from": {
            "description": "Current path, e.g. `eng/rust/diagram.png`.",
            "type": "string"
          },
          "to": {
            "description": "New path.",
            "type": "string"
          },
          "dry_run": {
            "description": "Return the Plan without applying it.",
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "from",
          "to"
        ]
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "MoveAttachmentOutput",
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          },
          "applied": {
            "type": "boolean"
          },
          "links_rewritten": {
            "description": "Links rewritten across the Wiki.",
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "required": [
          "from",
          "to",
          "plan",
          "applied",
          "links_rewritten"
        ],
        "$defs": {
          "Plan": {
            "type": "object",
            "properties": {
              "edits": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Edit"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Warning"
                }
              }
            },
            "required": [
              "edits",
              "warnings"
            ]
          },
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ]
              },
              {
                "description": "Create a new file with binary content (an Attachment). The bytes are\nstaged in the cache dir, not carried in the Plan.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "version": {
                    "description": "Hash of the content, as a `Version`.",
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create_binary"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "size",
                  "version"
                ]
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    }
                  },
                  "op": {
                    "type": "string",
                    "const": "modify"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ]
              },
              {
                "description": "Move a file, unchanged, to a path that doesn't exist yet.",
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "move"
                  }
                },
                "required": [
                  "op",
                  "from",
                  "to"
                ]
              },
              {
                "description": "Delete a file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "delete"
                  }
                },
                "required": [
                  "op",
                  "path"
                ]
              }
            ]
          },
          "Splice": {
            "type": "object",
            "properties": {
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ]
          },
          "Warning": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ]
          }
        }
      }
    },
    {
      "name": "delete_attachment",
      "kind": "mutation",
      "description": "Delete an Attachment. The Plan warns about Links that will break.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
