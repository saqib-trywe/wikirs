                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ]
              },
              {
                "description": "Create a new file with binary content (an Attachment). The bytes are\nstaged in the cache dir, not carried in the Plan.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "version": {
                    "description": "Hash of the content, as a `Version`.",
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create_binary"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "size",
                  "version"
                ]
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    }
                  },
                  "op": {
                    "type": "string",
                    "const": "modify"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ]
              },
              {
                "description": "Move a file, unchanged, to a path that doesn't exist yet.",
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "move"
                  }
                },
                "required": [
                  "op",
                  "from",
                  "to"
                ]
              },
              {
                "description": "Delete a file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "delete"
                  }
                },
                "required": [
                  "op",
                  "path"
                ]
              }
            ]
          },
          "Splice": {
            "type": "object",
            "properties": {
