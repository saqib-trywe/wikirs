                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "version": {
                    "description": "Hash of the content, as a `Version`.",
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
