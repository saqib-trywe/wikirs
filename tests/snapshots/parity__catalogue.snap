---
source: tests/parity.rs
expression: "wikirs_core::catalogue()"
---
{
  "operations": [
    {
      "description": "Read a Page: its raw markdown, Title and version.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Read one Page.",
        "properties": {
          "page": {
            "description": "Page Path, e.g. `eng/rust/async-notes`.",
            "type": "string"
          }
        },
        "required": [
          "page"
        ],
        "title": "GetPageInput",
        "type": "object"
      },
      "kind": "query",
      "name": "get_page",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "content": {
            "description": "Raw markdown, exactly as stored.",
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "description": "Opaque content hash; pass it back as `base_version` when writing.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "title",
          "content",
          "version"
        ],
        "title": "GetPageOutput",
        "type": "object"
      }
    },
    {
      "description": "Create a Page at a path, or under a parent from a Title.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Create a Page, either at `path` or under `parent` from a `title`.",
        "properties": {
          "content": {
            "description": "Initial markdown.",
            "type": [
              "string",
              "null"
            ]
          },
          "dry_run": {
            "default": false,
            "description": "Return the Plan without applying it.",
            "type": "boolean"
          },
          "parent": {
            "description": "Parent Page Path for a `title`-based create (Wiki root if absent).",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Page Path to create. Give either this or `title`.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "description": "Title: slugified into the filename and written as the H1.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "CreatePageInput",
        "type": "object"
      },
      "kind": "mutation",
      "name": "create_page",
      "output_schema": {
        "$defs": {
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "const": "create",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ],
                "type": "object"
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "properties": {
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "op": {
                    "const": "modify",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ],
                "type": "object"
              }
            ]
          },
          "Plan": {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/$defs/Edit"
                },
                "type": "array"
              },
              "warnings": {
                "items": {
                  "$ref": "#/$defs/Warning"
                },
                "type": "array"
              }
            },
            "required": [
              "edits",
              "warnings"
            ],
            "type": "object"
          },
          "Splice": {
            "properties": {
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              },
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "items": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ],
            "type": "object"
          },
          "Warning": {
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "applied": {
            "type": "boolean"
          },
          "path": {
            "description": "The Page Path that was (or would be) created.",
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          }
        },
        "required": [
          "path",
          "plan",
          "applied"
        ],
        "title": "CreatePageOutput",
        "type": "object"
      }
    },
    {
      "description": "Replace a Page's content. Pass `base_version` to refuse if it changed since you read it.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Replace a Page's whole content.",
        "properties": {
          "base_version": {
            "description": "The `version` you read; if the Page changed since, nothing is written (`conflict`).",
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "description": "The new markdown.",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "Return the Plan without applying it.",
            "type": "boolean"
          },
          "page": {
            "description": "Page Path.",
            "type": "string"
          }
        },
        "required": [
          "page",
          "content"
        ],
        "title": "WritePageInput",
        "type": "object"
      },
      "kind": "mutation",
      "name": "write_page",
      "output_schema": {
        "$defs": {
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "const": "create",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ],
                "type": "object"
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "properties": {
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "op": {
                    "const": "modify",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ],
                "type": "object"
              }
            ]
          },
          "Plan": {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/$defs/Edit"
                },
                "type": "array"
              },
              "warnings": {
                "items": {
                  "$ref": "#/$defs/Warning"
                },
                "type": "array"
              }
            },
            "required": [
              "edits",
              "warnings"
            ],
            "type": "object"
          },
          "Splice": {
            "properties": {
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              },
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "items": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ],
            "type": "object"
          },
          "Warning": {
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of a content write: the Plan and the Page's version afterwards.",
        "properties": {
          "applied": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          },
          "version": {
            "description": "The Page's version once the Plan is applied.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "plan",
          "applied",
          "version"
        ],
        "title": "WriteOutput",
        "type": "object"
      }
    },
    {
      "description": "Replace exact strings in a Page; each `old` must match exactly once.",
      "input_schema": {
        "$defs": {
          "Replacement": {
            "description": "One exact-string replacement: `old` must occur exactly once in the Page.",
            "properties": {
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              }
            },
            "required": [
              "old",
              "new"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Replace exact strings in a Page. All replacements apply, or none do.",
        "properties": {
          "base_version": {
            "description": "The `version` you read; if the Page changed since, nothing is written (`conflict`).",
            "type": [
              "string",
              "null"
            ]
          },
          "dry_run": {
            "default": false,
            "description": "Return the Plan without applying it.",
            "type": "boolean"
          },
          "edits": {
            "description": "Replacements, each matched against the Page as it is now.",
            "items": {
              "$ref": "#/$defs/Replacement"
            },
            "type": "array"
          },
          "page": {
            "description": "Page Path.",
            "type": "string"
          }
        },
        "required": [
          "page",
          "edits"
        ],
        "title": "EditPageInput",
        "type": "object"
      },
      "kind": "mutation",
      "name": "edit_page",
      "output_schema": {
        "$defs": {
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "const": "create",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ],
                "type": "object"
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "properties": {
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "op": {
                    "const": "modify",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ],
                "type": "object"
              }
            ]
          },
          "Plan": {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/$defs/Edit"
                },
                "type": "array"
              },
              "warnings": {
                "items": {
                  "$ref": "#/$defs/Warning"
                },
                "type": "array"
              }
            },
            "required": [
              "edits",
              "warnings"
            ],
            "type": "object"
          },
          "Splice": {
            "properties": {
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              },
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "items": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ],
            "type": "object"
          },
          "Warning": {
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of a content write: the Plan and the Page's version afterwards.",
        "properties": {
          "applied": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          },
          "version": {
            "description": "The Page's version once the Plan is applied.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "plan",
          "applied",
          "version"
        ],
        "title": "WriteOutput",
        "type": "object"
      }
    }
  ],
  "version": "0.1.0"
}
