---
source: tests/parity.rs
expression: "wikirs_core::catalogue()"
---
{
  "operations": [
    {
      "description": "Read a Page: its raw markdown, Title and version.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Read one Page.",
        "properties": {
          "page": {
            "description": "Page Path, e.g. `eng/rust/async-notes`.",
            "type": "string"
          }
        },
        "required": [
          "page"
        ],
        "title": "GetPageInput",
        "type": "object"
      },
      "kind": "query",
      "name": "get_page",
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "content": {
            "description": "Raw markdown, exactly as stored.",
            "type": "string"
          },
          "frontmatter": {
            "description": "The frontmatter as JSON, or null if the Page has none."
          },
          "path": {
            "type": "string"
          },
          "tags": {
            "description": "The Page's Tags (frontmatter and inline), lowercase, deduplicated.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "description": "Opaque content hash; pass it back as `base_version` when writing.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "title",
          "content",
          "tags",
          "version"
        ],
        "title": "GetPageOutput",
        "type": "object"
      }
    },
    {
      "description": "List Pages, filtered by Space or path prefix, sorted and paged.",
      "input_schema": {
        "$defs": {
          "Filter": {
            "additionalProperties": false,
            "description": "Which Pages a query covers (operations.md `Filter`).",
            "properties": {
              "exact": {
                "default": false,
                "description": "With `tag`: only the Tag itself, not its descendants.",
                "type": "boolean"
              },
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "tag": {
                "description": "Only Pages carrying this Tag or, unless `exact`, one of its descendants.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          },
          "Sort": {
            "enum": [
              "path",
              "title",
              "modified"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "List Pages, optionally filtered, sorted and paged.",
        "properties": {
          "filter": {
            "$ref": "#/$defs/Filter"
          },
          "limit": {
            "description": "At most this many (default 100).",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "description": "Skip this many first.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "sort": {
            "$ref": "#/$defs/Sort",
            "description": "`path` (default), `title` or `modified` (newest first)."
          }
        },
        "title": "ListPagesInput",
        "type": "object"
      },
      "kind": "query",
      "name": "list_pages",
      "output_schema": {
        "$defs": {
          "PageRow": {
            "properties": {
              "modified": {
                "description": "Last modified, milliseconds since the Unix epoch.",
                "format": "int64",
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "tags": {
                "description": "The Page's Tags, lowercase.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "title",
              "tags",
              "modified"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "pages": {
            "items": {
              "$ref": "#/$defs/PageRow"
            },
            "type": "array"
          },
          "total": {
            "description": "Matching Pages before `limit` / `offset`.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "pages",
          "total"
        ],
        "title": "ListPagesOutput",
        "type": "object"
      }
    },
    {
      "description": "The Links a Page makes, each resolved: ok, broken, heading_missing or case_fallback.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "The Links a Page makes.",
        "properties": {
          "page": {
            "description": "Page Path.",
            "type": "string"
          }
        },
        "required": [
          "page"
        ],
        "title": "LinksInput",
        "type": "object"
      },
      "kind": "query",
      "name": "links",
      "output_schema": {
        "$defs": {
          "LinkOut": {
            "properties": {
              "heading": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "range": {
                "description": "Byte range `[start, end)` in the Page.",
                "items": {
                  "format": "int64",
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "raw": {
                "description": "The Link's source text.",
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/LinkStatus"
              },
              "target": {
                "description": "Page Path (no `.md`) or Attachment path.",
                "type": "string"
              },
              "target_kind": {
                "$ref": "#/$defs/TargetKind"
              }
            },
            "required": [
              "raw",
              "range",
              "target",
              "target_kind",
              "status"
            ],
            "type": "object"
          },
          "LinkStatus": {
            "enum": [
              "ok",
              "broken",
              "heading_missing",
              "case_fallback"
            ],
            "type": "string"
          },
          "TargetKind": {
            "enum": [
              "page",
              "attachment"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "links": {
            "items": {
              "$ref": "#/$defs/LinkOut"
            },
            "type": "array"
          }
        },
        "required": [
          "links"
        ],
        "title": "LinksOutput",
        "type": "object"
      }
    },
    {
      "description": "The Links pointing at a Page or Attachment (including Broken ones).",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "The Links pointing at a Page or Attachment.",
        "properties": {
          "target": {
            "description": "Page Path or Attachment path. A missing target is fine: Broken Links point at it.",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "title": "BacklinksInput",
        "type": "object"
      },
      "kind": "query",
      "name": "backlinks",
      "output_schema": {
        "$defs": {
          "Backlink": {
            "properties": {
              "from": {
                "description": "The linking Page.",
                "type": "string"
              },
              "range": {
                "items": {
                  "format": "int64",
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "raw": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "range",
              "raw"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "backlinks": {
            "items": {
              "$ref": "#/$defs/Backlink"
            },
            "type": "array"
          }
        },
        "required": [
          "backlinks"
        ],
        "title": "BacklinksOutput",
        "type": "object"
      }
    },
    {
      "description": "Resolve a Link as written in a Page: its target and status.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Resolve one Link as it would be written in a Page.",
        "properties": {
          "from_page": {
            "description": "The Page the Link is written in (relative Links resolve from here).",
            "type": "string"
          },
          "raw": {
            "description": "The Link's source, e.g. `[[eng/rust#Pinning]]` or `[x](../a.md)`.",
            "type": "string"
          }
        },
        "required": [
          "from_page",
          "raw"
        ],
        "title": "ResolveLinkInput",
        "type": "object"
      },
      "kind": "query",
      "name": "resolve_link",
      "output_schema": {
        "$defs": {
          "LinkStatus": {
            "enum": [
              "ok",
              "broken",
              "heading_missing",
              "case_fallback"
            ],
            "type": "string"
          },
          "TargetKind": {
            "enum": [
              "page",
              "attachment"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "heading": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/$defs/LinkStatus"
          },
          "target": {
            "description": "Page Path (no `.md`) or Attachment path.",
            "type": "string"
          },
          "target_kind": {
            "$ref": "#/$defs/TargetKind"
          }
        },
        "required": [
          "target",
          "target_kind",
          "status"
        ],
        "title": "Resolved",
        "type": "object"
      }
    },
    {
      "description": "A Page's headings, with their level and anchor.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "A Page's headings.",
        "properties": {
          "page": {
            "description": "Page Path.",
            "type": "string"
          }
        },
        "required": [
          "page"
        ],
        "title": "OutlineInput",
        "type": "object"
      },
      "kind": "query",
      "name": "outline",
      "output_schema": {
        "$defs": {
          "OutlineHeading": {
            "properties": {
              "anchor": {
                "description": "Use as a Link's `#heading`.",
                "type": "string"
              },
              "level": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "level",
              "text",
              "anchor"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "headings": {
            "items": {
              "$ref": "#/$defs/OutlineHeading"
            },
            "type": "array"
          }
        },
        "required": [
          "headings"
        ],
        "title": "OutlineOutput",
        "type": "object"
      }
    },
    {
      "description": "The Tag hierarchy with direct and inclusive Page counts.",
      "input_schema": {
        "$defs": {
          "Scope": {
            "additionalProperties": false,
            "description": "Which part of the Wiki a query covers (operations.md `Scope`).",
            "properties": {
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "The Tag hierarchy with Page counts.",
        "properties": {
          "scope": {
            "$ref": "#/$defs/Scope",
            "description": "Only Pages in this part of the Wiki."
          }
        },
        "title": "TagTreeInput",
        "type": "object"
      },
      "kind": "query",
      "name": "tag_tree",
      "output_schema": {
        "$defs": {
          "TagNode": {
            "properties": {
              "children": {
                "items": {
                  "$ref": "#/$defs/TagNode"
                },
                "type": "array"
              },
              "direct": {
                "description": "Pages carrying exactly this Tag.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "inclusive": {
                "description": "Pages carrying this Tag or any descendant.",
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "tag": {
                "description": "Full Tag, lowercase (e.g. `lang/rust`).",
                "type": "string"
              }
            },
            "required": [
              "tag",
              "direct",
              "inclusive",
              "children"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "tags": {
            "items": {
              "$ref": "#/$defs/TagNode"
            },
            "type": "array"
          }
        },
        "required": [
          "tags"
        ],
        "title": "TagTreeOutput",
        "type": "object"
      }
    },
    {
      "description": "Diagnostics: Broken Links, missing headings, case fallbacks, mixed-case Tags, unrecovered edits.",
      "input_schema": {
        "$defs": {
          "DiagnosticKind": {
            "enum": [
              "broken_link",
              "heading_missing",
              "case_fallback",
              "mixed_case_tag",
              "unrecovered_edit"
            ],
            "type": "string"
          },
          "Scope": {
            "additionalProperties": false,
            "description": "Which part of the Wiki a query covers (operations.md `Scope`).",
            "properties": {
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Every diagnostic in the Wiki, or a part of it.",
        "properties": {
          "kinds": {
            "default": [],
            "description": "Only these kinds (default: all).",
            "items": {
              "$ref": "#/$defs/DiagnosticKind"
            },
            "type": "array"
          },
          "scope": {
            "$ref": "#/$defs/Scope",
            "description": "Only Pages in this part of the Wiki."
          }
        },
        "title": "CheckInput",
        "type": "object"
      },
      "kind": "query",
      "name": "check",
      "output_schema": {
        "$defs": {
          "Diagnostic": {
            "properties": {
              "kind": {
                "$ref": "#/$defs/DiagnosticKind"
              },
              "message": {
                "type": "string"
              },
              "page": {
                "description": "The Page (or file) it's about.",
                "type": "string"
              },
              "range": {
                "description": "Byte range in the Page, when there is one.",
                "items": {
                  "format": "int64",
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": [
                  "array",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "page",
              "message"
            ],
            "type": "object"
          },
          "DiagnosticKind": {
            "enum": [
              "broken_link",
              "heading_missing",
              "case_fallback",
              "mixed_case_tag",
              "unrecovered_edit"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "diagnostics": {
            "items": {
              "$ref": "#/$defs/Diagnostic"
            },
            "type": "array"
          }
        },
        "required": [
          "diagnostics"
        ],
        "title": "CheckOutput",
        "type": "object"
      }
    },
    {
      "description": "Create a Page at a path, or under a parent from a Title.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Create a Page, either at `path` or under `parent` from a `title`.",
        "properties": {
          "content": {
            "description": "Initial markdown. (May start with `---` frontmatter.)",
            "type": [
              "string",
              "null"
            ]
          },
          "dry_run": {
            "default": false,
            "description": "Return the Plan without applying it.",
            "type": "boolean"
          },
          "parent": {
            "description": "Parent Page Path for a `title`-based create (Wiki root if absent).",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Page Path to create. Give either this or `title`.",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "description": "Title: slugified into the filename and written as the H1.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "title": "CreatePageInput",
        "type": "object"
      },
      "kind": "mutation",
      "name": "create_page",
      "output_schema": {
        "$defs": {
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "const": "create",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ],
                "type": "object"
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "properties": {
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "op": {
                    "const": "modify",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ],
                "type": "object"
              }
            ]
          },
          "Plan": {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/$defs/Edit"
                },
                "type": "array"
              },
              "warnings": {
                "items": {
                  "$ref": "#/$defs/Warning"
                },
                "type": "array"
              }
            },
            "required": [
              "edits",
              "warnings"
            ],
            "type": "object"
          },
          "Splice": {
            "properties": {
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              },
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "items": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ],
            "type": "object"
          },
          "Warning": {
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "applied": {
            "type": "boolean"
          },
          "path": {
            "description": "The Page Path that was (or would be) created.",
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          }
        },
        "required": [
          "path",
          "plan",
          "applied"
        ],
        "title": "CreatePageOutput",
        "type": "object"
      }
    },
    {
      "description": "Replace a Page's content. Pass `base_version` to refuse if it changed since you read it.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Replace a Page's whole content.",
        "properties": {
          "base_version": {
            "description": "The `version` you read; if the Page changed since, nothing is written (`conflict`).",
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "description": "The new markdown. (May start with `---` frontmatter.)",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "Return the Plan without applying it.",
            "type": "boolean"
          },
          "page": {
            "description": "Page Path.",
            "type": "string"
          }
        },
        "required": [
          "page",
          "content"
        ],
        "title": "WritePageInput",
        "type": "object"
      },
      "kind": "mutation",
      "name": "write_page",
      "output_schema": {
        "$defs": {
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "const": "create",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ],
                "type": "object"
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "properties": {
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "op": {
                    "const": "modify",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ],
                "type": "object"
              }
            ]
          },
          "Plan": {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/$defs/Edit"
                },
                "type": "array"
              },
              "warnings": {
                "items": {
                  "$ref": "#/$defs/Warning"
                },
                "type": "array"
              }
            },
            "required": [
              "edits",
              "warnings"
            ],
            "type": "object"
          },
          "Splice": {
            "properties": {
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              },
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "items": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ],
            "type": "object"
          },
          "Warning": {
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of a content write: the Plan and the Page's version afterwards.",
        "properties": {
          "applied": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          },
          "version": {
            "description": "The Page's version once the Plan is applied.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "plan",
          "applied",
          "version"
        ],
        "title": "WriteOutput",
        "type": "object"
      }
    },
    {
      "description": "Replace exact strings in a Page; each `old` must match exactly once.",
      "input_schema": {
        "$defs": {
          "Replacement": {
            "additionalProperties": false,
            "description": "One exact-string replacement: `old` must occur exactly once in the Page.",
            "properties": {
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              }
            },
            "required": [
              "old",
              "new"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Replace exact strings in a Page. All replacements apply, or none do.",
        "properties": {
          "base_version": {
            "description": "The `version` you read; if the Page changed since, nothing is written (`conflict`).",
            "type": [
              "string",
              "null"
            ]
          },
          "dry_run": {
            "default": false,
            "description": "Return the Plan without applying it.",
            "type": "boolean"
          },
          "edits": {
            "description": "Replacements, each matched against the Page as it is now.",
            "items": {
              "$ref": "#/$defs/Replacement"
            },
            "type": "array"
          },
          "page": {
            "description": "Page Path.",
            "type": "string"
          }
        },
        "required": [
          "page",
          "edits"
        ],
        "title": "EditPageInput",
        "type": "object"
      },
      "kind": "mutation",
      "name": "edit_page",
      "output_schema": {
        "$defs": {
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "const": "create",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ],
                "type": "object"
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "properties": {
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "op": {
                    "const": "modify",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ],
                "type": "object"
              }
            ]
          },
          "Plan": {
            "properties": {
              "edits": {
                "items": {
                  "$ref": "#/$defs/Edit"
                },
                "type": "array"
              },
              "warnings": {
                "items": {
                  "$ref": "#/$defs/Warning"
                },
                "type": "array"
              }
            },
            "required": [
              "edits",
              "warnings"
            ],
            "type": "object"
          },
          "Splice": {
            "properties": {
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              },
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "items": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ],
            "type": "object"
          },
          "Warning": {
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Result of a content write: the Plan and the Page's version afterwards.",
        "properties": {
          "applied": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          },
          "version": {
            "description": "The Page's version once the Plan is applied.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "plan",
          "applied",
          "version"
        ],
        "title": "WriteOutput",
        "type": "object"
      }
    },
    {
      "description": "Full-text search: plain terms, \"quoted phrases\" and prefix* (all must match).",
      "input_schema": {
        "$defs": {
          "Filter": {
            "additionalProperties": false,
            "description": "Which Pages a query covers (operations.md `Filter`).",
            "properties": {
              "exact": {
                "default": false,
                "description": "With `tag`: only the Tag itself, not its descendants.",
                "type": "boolean"
              },
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "tag": {
                "description": "Only Pages carrying this Tag or, unless `exact`, one of its descendants.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Full-text search over Pages.",
        "properties": {
          "filter": {
            "$ref": "#/$defs/Filter"
          },
          "limit": {
            "description": "At most this many (default 100).",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "offset": {
            "description": "Skip this many first.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "text": {
            "description": "Plain terms (all must match), `\"quoted phrases\"`, and `prefix*`.",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "SearchInput",
        "type": "object"
      },
      "kind": "query",
      "name": "search",
      "output_schema": {
        "$defs": {
          "Hit": {
            "properties": {
              "path": {
                "type": "string"
              },
              "score": {
                "description": "Relevance; higher is better.",
                "format": "double",
                "type": "number"
              },
              "snippet": {
                "description": "Matching text with matches wrapped in `**`.",
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "title",
              "snippet",
              "score"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/$defs/Hit"
            },
            "type": "array"
          },
          "total": {
            "description": "Matching Pages before `limit` / `offset`.",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "hits",
          "total"
        ],
        "title": "SearchOutput",
        "type": "object"
      }
    },
    {
      "description": "Report on the Index: counts, freshness, skipped files, unrecovered edits.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "description": "Report on the Index.",
        "title": "IndexStatusInput",
        "type": "object"
      },
      "kind": "query",
      "name": "index_status",
      "output_schema": {
        "$defs": {
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "const": "create",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ],
                "type": "object"
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "properties": {
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "op": {
                    "const": "modify",
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ],
                "type": "object"
              }
            ]
          },
          "Skipped": {
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "description": "`symlink`, `non_utf8` or `case_clash`.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "type": "object"
          },
          "Splice": {
            "properties": {
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              },
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "items": {
                  "format": "uint",
                  "minimum": 0,
                  "type": "integer"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ],
            "type": "object"
          },
          "UnrecoveredEdit": {
            "description": "An edit from a crashed Plan that recovery left alone because its file had\nchanged in the meantime. Reported by `index_status` and `check`.",
            "properties": {
              "edit": {
                "$ref": "#/$defs/Edit"
              },
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "edit"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "attachments": {
            "format": "int64",
            "type": "integer"
          },
          "cache_dir": {
            "description": "Per-Wiki cache dir (Index, write lock, journal).",
            "type": "string"
          },
          "last_updated": {
            "description": "When the Index last changed, milliseconds since the Unix epoch.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "links": {
            "description": "Links written in Pages (resolved or not).",
            "format": "int64",
            "type": "integer"
          },
          "pages": {
            "format": "int64",
            "type": "integer"
          },
          "root": {
            "description": "The Wiki root this process resolved.",
            "type": "string"
          },
          "skipped": {
            "items": {
              "$ref": "#/$defs/Skipped"
            },
            "type": "array"
          },
          "stale": {
            "description": "Whether the Index may be behind the files (always false right after open).",
            "type": "boolean"
          },
          "tags": {
            "description": "Distinct Tags.",
            "format": "int64",
            "type": "integer"
          },
          "unrecovered_edits": {
            "items": {
              "$ref": "#/$defs/UnrecoveredEdit"
            },
            "type": "array"
          },
          "watcher": {
            "description": "File watching in this process: `none` (one-shot) until watchers exist.",
            "type": "string"
          }
        },
        "required": [
          "root",
          "cache_dir",
          "pages",
          "attachments",
          "links",
          "tags",
          "stale",
          "watcher",
          "skipped",
          "unrecovered_edits"
        ],
        "title": "IndexStatusOutput",
        "type": "object"
      }
    },
    {
      "description": "Drop the Index and rebuild it from the files. Changes no Wiki file.",
