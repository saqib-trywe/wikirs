        "type": "object",
        "properties": {
          "path": {
            "description": "Path from the Wiki root.",
            "type": "string"
          },
          "dry_run": {
            "description": "Return the Plan without applying it.",
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "path"
        ]
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "DeleteAttachmentOutput",
        "type": "object",
        "properties": {
