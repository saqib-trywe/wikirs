    {
      "name": "get_page",
      "kind": "query",
      "description": "Read a Page: its raw markdown, Title and version.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "GetPageInput",
        "description": "Read one Page.",
        "type": "object",
        "properties": {
          "page": {
            "description": "Page Path, e.g. `eng/rust/async-notes`.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "page"
        ]
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "GetPageOutput",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "description": "Raw markdown, exactly as stored.",
            "type": "string"
          },
          "frontmatter": {
            "description": "The frontmatter as JSON, or null if the Page has none."
          },
          "tags": {
            "description": "The Page's Tags (frontmatter and inline), lowercase, deduplicated.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "description": "Opaque content hash; pass it back as `base_version` when writing.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "title",
          "content",
          "tags",
          "version"
        ]
      }
    },
    {
      "name": "list_pages",
      "kind": "query",
      "description": "List Pages, filtered by Space or path prefix, sorted and paged.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ListPagesInput",
        "description": "List Pages, optionally filtered, sorted and paged.",
        "type": "object",
        "properties": {
          "filter": {
            "$ref": "#/$defs/Filter"
          },
          "sort": {
            "description": "`path` (default), `title` or `modified` (newest first).",
            "$ref": "#/$defs/Sort"
          },
          "limit": {
            "description": "At most this many (default 100).",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          },
          "offset": {
            "description": "Skip this many first.",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "$defs": {
          "Filter": {
            "description": "Which Pages a query covers (operations.md `Filter`).",
            "type": "object",
            "properties": {
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "tag": {
                "description": "Only Pages carrying this Tag or, unless `exact`, one of its descendants.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "exact": {
                "description": "With `tag`: only the Tag itself, not its descendants.",
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          },
          "Sort": {
            "type": "string",
            "enum": [
              "path",
              "title",
              "modified"
            ]
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ListPagesOutput",
        "type": "object",
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/PageRow"
            }
          },
          "total": {
            "description": "Matching Pages before `limit` / `offset`.",
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "pages",
          "total"
        ],
        "$defs": {
          "PageRow": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "tags": {
                "description": "The Page's Tags, lowercase.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "modified": {
                "description": "Last modified, milliseconds since the Unix epoch.",
                "type": "integer",
                "format": "int64"
              }
            },
            "required": [
              "path",
              "title",
              "tags",
              "modified"
            ]
          }
        }
      }
    },
    {
      "name": "children",
      "kind": "query",
      "description": "List the Child Pages and Placeholders under a Page (or the Wiki root), in display order.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ChildrenInput",
        "description": "List the Child Pages and Placeholders under a Page, in display order.",
        "type": "object",
        "properties": {
          "parent": {
            "description": "Page Path or Placeholder; the Wiki root if absent.",
            "type": [
              "string",
              "null"
            ]
          },
          "depth": {
            "description": "Levels to list: 1 is direct children only.",
            "type": "integer",
            "format": "uint32",
            "minimum": 0,
            "default": 1
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ChildrenOutput",
        "type": "object",
        "properties": {
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ChildNode"
            }
          }
        },
        "required": [
          "children"
        ],
        "$defs": {
          "ChildNode": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "title": {
                "description": "The Page's Title, or a Placeholder's folder name.",
                "type": "string"
              },
              "kind": {
                "$ref": "#/$defs/NodeKind"
              },
              "has_children": {
                "type": "boolean"
              },
              "children": {
                "description": "Its own children, while `depth` lasts.",
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "$ref": "#/$defs/ChildNode"
                }
              }
            },
            "required": [
              "path",
              "title",
              "kind",
              "has_children"
            ]
          },
          "NodeKind": {
            "type": "string",
            "enum": [
              "page",
              "placeholder"
            ]
          }
        }
      }
    },
    {
      "name": "list_spaces",
      "kind": "query",
      "description": "List the Spaces (top-level folders holding Pages) with their home Pages and Page counts.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ListSpacesInput",
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ListSpacesOutput",
        "type": "object",
        "properties": {
          "spaces": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Space"
            }
          }
        },
        "required": [
          "spaces"
        ],
        "$defs": {
          "Space": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "home_page": {
                "description": "`<name>`, if the Space has a home Page.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "page_count": {
                "description": "Pages in the Space, its home Page included.",
                "type": "integer",
                "format": "uint",
                "minimum": 0
              }
            },
            "required": [
              "name",
              "page_count"
            ]
          }
        }
      }
    },
    {
      "name": "links",
      "kind": "query",
      "description": "The Links a Page makes, each resolved: ok, broken, heading_missing or case_fallback.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "LinksInput",
        "description": "The Links a Page makes.",
        "type": "object",
        "properties": {
          "page": {
            "description": "Page Path.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "page"
        ]
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "LinksOutput",
        "type": "object",
        "properties": {
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/LinkOut"
            }
          }
        },
        "required": [
          "links"
        ],
        "$defs": {
          "LinkOut": {
            "type": "object",
            "properties": {
              "raw": {
                "description": "The Link's source text.",
                "type": "string"
              },
              "range": {
                "description": "Byte range `[start, end)` in the Page.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int64"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "target": {
                "description": "Page Path (no `.md`) or Attachment path.",
                "type": "string"
              },
              "target_kind": {
                "$ref": "#/$defs/TargetKind"
              },
              "heading": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "$ref": "#/$defs/LinkStatus"
              }
            },
            "required": [
              "raw",
              "range",
              "target",
              "target_kind",
              "status"
            ]
          },
          "TargetKind": {
            "type": "string",
            "enum": [
              "page",
              "attachment"
            ]
          },
          "LinkStatus": {
            "type": "string",
            "enum": [
              "ok",
              "broken",
              "heading_missing",
              "case_fallback"
            ]
          }
        }
      }
    },
    {
      "name": "backlinks",
      "kind": "query",
      "description": "The Links pointing at a Page or Attachment (including Broken ones).",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "BacklinksInput",
        "description": "The Links pointing at a Page or Attachment.",
        "type": "object",
        "properties": {
          "target": {
            "description": "Page Path or Attachment path. A missing target is fine: Broken Links point at it.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "target"
        ]
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "BacklinksOutput",
        "type": "object",
        "properties": {
          "backlinks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Backlink"
            }
          }
        },
        "required": [
          "backlinks"
        ],
        "$defs": {
          "Backlink": {
            "type": "object",
            "properties": {
              "from": {
                "description": "The linking Page.",
                "type": "string"
              },
              "range": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int64"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "raw": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "range",
              "raw"
            ]
          }
        }
      }
    },
    {
      "name": "resolve_link",
      "kind": "query",
      "description": "Resolve a Link as written in a Page: its target and status.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ResolveLinkInput",
        "description": "Resolve one Link as it would be written in a Page.",
        "type": "object",
        "properties": {
          "from_page": {
            "description": "The Page the Link is written in (relative Links resolve from here).",
            "type": "string"
          },
          "raw": {
            "description": "The Link's source, e.g. `[[eng/rust#Pinning]]` or `[x](../a.md)`.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "from_page",
          "raw"
        ]
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Resolved",
        "type": "object",
        "properties": {
          "target": {
            "description": "Page Path (no `.md`) or Attachment path.",
            "type": "string"
          },
          "target_kind": {
            "$ref": "#/$defs/TargetKind"
          },
          "heading": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/$defs/LinkStatus"
          }
        },
        "required": [
          "target",
          "target_kind",
          "status"
        ],
        "$defs": {
          "TargetKind": {
            "type": "string",
            "enum": [
              "page",
              "attachment"
            ]
          },
          "LinkStatus": {
            "type": "string",
            "enum": [
              "ok",
              "broken",
              "heading_missing",
              "case_fallback"
            ]
          }
        }
      }
    },
    {
      "name": "outline",
      "kind": "query",
      "description": "A Page's headings, with their level and anchor.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "OutlineInput",
        "description": "A Page's headings.",
        "type": "object",
        "properties": {
          "page": {
            "description": "Page Path.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "page"
        ]
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "OutlineOutput",
        "type": "object",
        "properties": {
          "headings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/OutlineHeading"
            }
          }
        },
        "required": [
          "headings"
        ],
        "$defs": {
          "OutlineHeading": {
            "type": "object",
            "properties": {
              "level": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0,
                "maximum": 255
              },
              "text": {
                "type": "string"
              },
              "anchor": {
                "description": "Use as a Link's `#heading`.",
                "type": "string"
              }
            },
            "required": [
              "level",
              "text",
              "anchor"
            ]
          }
        }
      }
    },
    {
      "name": "tag_tree",
      "kind": "query",
      "description": "The Tag hierarchy with direct and inclusive Page counts.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "TagTreeInput",
        "description": "The Tag hierarchy with Page counts.",
        "type": "object",
        "properties": {
          "scope": {
            "description": "Only Pages in this part of the Wiki.",
            "$ref": "#/$defs/Scope"
          }
        },
        "additionalProperties": false,
        "$defs": {
          "Scope": {
            "description": "Which part of the Wiki a query covers (operations.md `Scope`).",
            "type": "object",
            "properties": {
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "TagTreeOutput",
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/TagNode"
            }
          }
        },
        "required": [
          "tags"
        ],
        "$defs": {
          "TagNode": {
            "type": "object",
            "properties": {
              "tag": {
                "description": "Full Tag, lowercase (e.g. `lang/rust`).",
                "type": "string"
              },
              "direct": {
                "description": "Pages carrying exactly this Tag.",
                "type": "integer",
                "format": "uint",
                "minimum": 0
              },
              "inclusive": {
                "description": "Pages carrying this Tag or any descendant.",
                "type": "integer",
                "format": "uint",
                "minimum": 0
              },
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/TagNode"
                }
              }
            },
            "required": [
              "tag",
              "direct",
              "inclusive",
              "children"
            ]
          }
        }
      }
    },
    {
      "name": "check",
      "kind": "query",
      "description": "Diagnostics: Broken Links, missing headings, case fallbacks, mixed-case Tags, unrecovered edits.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "CheckInput",
        "description": "Every diagnostic in the Wiki, or a part of it.",
        "type": "object",
        "properties": {
          "scope": {
            "description": "Only Pages in this part of the Wiki.",
            "$ref": "#/$defs/Scope"
          },
          "kinds": {
            "description": "Only these kinds (default: all).",
            "type": "array",
            "items": {
              "$ref": "#/$defs/DiagnosticKind"
            },
            "default": []
          }
        },
        "additionalProperties": false,
        "$defs": {
          "Scope": {
            "description": "Which part of the Wiki a query covers (operations.md `Scope`).",
            "type": "object",
            "properties": {
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "DiagnosticKind": {
            "type": "string",
            "enum": [
              "broken_link",
              "heading_missing",
              "case_fallback",
              "mixed_case_tag",
              "unrecovered_edit"
            ]
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "CheckOutput",
        "type": "object",
        "properties": {
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Diagnostic"
            }
          }
        },
        "required": [
          "diagnostics"
        ],
        "$defs": {
          "Diagnostic": {
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "#/$defs/DiagnosticKind"
              },
              "page": {
                "description": "The Page (or file) it's about.",
                "type": "string"
              },
              "range": {
                "description": "Byte range in the Page, when there is one.",
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "integer",
                  "format": "int64"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "page",
              "message"
            ]
          },
          "DiagnosticKind": {
            "type": "string",
            "enum": [
              "broken_link",
              "heading_missing",
              "case_fallback",
              "mixed_case_tag",
              "unrecovered_edit"
            ]
          }
        }
      }
    },
    {
      "name": "create_page",
      "kind": "mutation",
      "description": "Create a Page at a path, or under a parent from a Title.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "CreatePageInput",
        "description": "Create a Page, either at `path` or under `parent` from a `title`.",
        "type": "object",
        "properties": {
          "path": {
            "description": "Page Path to create. Give either this or `title`.",
            "type": [
              "string",
              "null"
            ]
          },
          "parent": {
            "description": "Parent Page Path for a `title`-based create (Wiki root if absent).",
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "description": "Title: slugified into the filename and written as the H1.",
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "description": "Initial markdown. (May start with `---` frontmatter.)",
            "type": [
              "string",
              "null"
            ]
          },
          "dry_run": {
            "description": "Return the Plan without applying it.",
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "CreatePageOutput",
        "type": "object",
        "properties": {
          "path": {
            "description": "The Page Path that was (or would be) created.",
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          },
          "applied": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "plan",
          "applied"
        ],
        "$defs": {
          "Plan": {
            "type": "object",
            "properties": {
              "edits": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Edit"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Warning"
                }
              }
            },
            "required": [
              "edits",
              "warnings"
            ]
          },
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ]
              },
              {
                "description": "Create a new file with binary content (an Attachment). The bytes are\nstaged in the cache dir, not carried in the Plan.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "version": {
                    "description": "Hash of the content, as a `Version`.",
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create_binary"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "size",
                  "version"
                ]
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    }
                  },
                  "op": {
                    "type": "string",
                    "const": "modify"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ]
              },
              {
                "description": "Move a file, unchanged, to a path that doesn't exist yet.",
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "move"
                  }
                },
                "required": [
                  "op",
                  "from",
                  "to"
                ]
              },
              {
                "description": "Delete a file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "delete"
                  }
                },
                "required": [
                  "op",
                  "path"
                ]
              }
            ]
          },
          "Splice": {
            "type": "object",
            "properties": {
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ]
          },
          "Warning": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ]
          }
        }
      }
    },
    {
      "name": "write_page",
      "kind": "mutation",
      "description": "Replace a Page's content. Pass `base_version` to refuse if it changed since you read it.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "WritePageInput",
        "description": "Replace a Page's whole content.",
        "type": "object",
        "properties": {
          "page": {
            "description": "Page Path.",
            "type": "string"
          },
          "content": {
            "description": "The new markdown. (May start with `---` frontmatter.)",
            "type": "string"
          },
          "base_version": {
            "description": "The `version` you read; if the Page changed since, nothing is written (`conflict`).",
            "type": [
              "string",
              "null"
