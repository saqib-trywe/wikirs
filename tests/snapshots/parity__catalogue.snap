source: tests/parity.rs
assertion_line: 893
expression: "wikirs_core::catalogue()"
---
{
  "version": "0.1.0",
  "operations": [
    {
      "name": "init",
      "kind": "mutation",
      "description": "Make a folder a Wiki by creating `.wikirs/config.toml`, which also marks its root.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "InitInput",
        "description": "Make this folder a Wiki: create `.wikirs/config.toml`.",
        "type": "object",
        "properties": {
          "dry_run": {
            "description": "Return the Plan without applying it.",
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "InitOutput",
        "type": "object",
        "properties": {
          "path": {
            "description": "The settings file created, relative to the Wiki root.",
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          },
          "applied": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "plan",
          "applied"
        ],
        "$defs": {
          "Plan": {
            "type": "object",
            "properties": {
              "edits": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Edit"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Warning"
                }
              }
            },
            "required": [
              "edits",
              "warnings"
            ]
          },
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ]
              },
              {
                "description": "Create a new file with binary content (an Attachment). The bytes are\nstaged in the cache dir, not carried in the Plan.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "version": {
                    "description": "Hash of the content, as a `Version`.",
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create_binary"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "size",
                  "version"
                ]
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    }
                  },
                  "op": {
                    "type": "string",
                    "const": "modify"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ]
              },
              {
                "description": "Move a file, unchanged, to a path that doesn't exist yet.",
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "move"
                  }
                },
                "required": [
                  "op",
                  "from",
                  "to"
                ]
              },
              {
                "description": "Delete a file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "delete"
                  }
                },
                "required": [
                  "op",
                  "path"
                ]
              }
            ]
          },
          "Splice": {
            "type": "object",
            "properties": {
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ]
          },
          "Warning": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ]
          }
        }
      }
    },
    {
      "name": "get_config",
      "kind": "query",
      "description": "Read one setting or all of them, each with its value and source (`machine`, `wiki` or `default`).",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "GetConfigInput",
        "description": "Read one setting, or all of them, with where each value comes from.",
        "type": "object",
        "properties": {
          "key": {
            "description": "A setting, e.g. `links.syntax`; every setting if absent.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "GetConfigOutput",
        "type": "object",
        "properties": {
          "settings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Setting"
            }
          }
        },
        "required": [
          "settings"
        ],
        "$defs": {
          "Setting": {
            "description": "One setting as `get_config` reports it.",
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "value": true,
              "source": {
                "$ref": "#/$defs/Source"
              },
              "scope": {
                "description": "The file it belongs in; `wiki` settings can also be overridden per machine.",
                "$ref": "#/$defs/ConfigScope"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "value",
              "source",
              "scope",
              "description"
            ]
          },
          "Source": {
            "description": "Where a setting's value came from.",
            "type": "string",
            "enum": [
              "wiki",
              "machine",
              "default"
            ]
          },
          "ConfigScope": {
            "description": "Which file a setting is written to.",
            "oneOf": [
              {
                "description": "`.wikirs/config.toml`, committed and shared by every machine.",
                "type": "string",
                "const": "wiki"
              },
              {
                "description": "This machine's settings for the Wiki, outside it, never synced.",
                "type": "string",
                "const": "machine"
              }
            ]
          }
        }
      }
    },
    {
