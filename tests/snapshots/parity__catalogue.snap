    {
      "name": "edit_page",
      "kind": "mutation",
      "description": "Replace exact strings in a Page; each `old` must match exactly once.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "EditPageInput",
        "description": "Replace exact strings in a Page. All replacements apply, or none do.",
        "type": "object",
        "properties": {
          "page": {
            "description": "Page Path.",
            "type": "string"
          },
          "edits": {
            "description": "Replacements, each matched against the Page as it is now.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/Replacement"
            }
          },
          "base_version": {
            "description": "The `version` you read; if the Page changed since, nothing is written (`conflict`).",
            "type": [
              "string",
              "null"
            ]
          },
          "dry_run": {
            "description": "Return the Plan without applying it.",
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "page",
          "edits"
        ],
        "$defs": {
          "Replacement": {
            "description": "One exact-string replacement: `old` must occur exactly once in the Page.",
            "type": "object",
            "properties": {
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "old",
              "new"
            ]
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "WriteOutput",
        "description": "Result of a content write: the Plan and the Page's version afterwards.",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "plan": {
            "$ref": "#/$defs/Plan"
          },
          "applied": {
            "type": "boolean"
          },
          "version": {
            "description": "The Page's version once the Plan is applied.",
            "type": "string"
          }
        },
        "required": [
          "path",
          "plan",
          "applied",
          "version"
        ],
        "$defs": {
          "Plan": {
            "type": "object",
            "properties": {
              "edits": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Edit"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Warning"
                }
              }
            },
            "required": [
              "edits",
              "warnings"
            ]
          },
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ]
              },
              {
                "description": "Create a new file with binary content (an Attachment). The bytes are\nstaged in the cache dir, not carried in the Plan.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "version": {
                    "description": "Hash of the content, as a `Version`.",
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create_binary"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "size",
                  "version"
                ]
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    }
                  },
                  "op": {
                    "type": "string",
                    "const": "modify"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ]
              },
              {
                "description": "Move a file, unchanged, to a path that doesn't exist yet.",
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "move"
                  }
                },
                "required": [
                  "op",
                  "from",
                  "to"
                ]
              },
              {
                "description": "Delete a file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "delete"
                  }
                },
                "required": [
                  "op",
                  "path"
                ]
              }
            ]
          },
          "Splice": {
            "type": "object",
            "properties": {
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ]
          },
          "Warning": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ]
          }
        }
      }
    },
    {
