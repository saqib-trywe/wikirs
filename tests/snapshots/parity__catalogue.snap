                    "type": "string",
                    "const": "create_binary"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "size",
                  "version"
                ]
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    }
                  },
                  "op": {
                    "type": "string",
                    "const": "modify"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ]
              },
              {
                "description": "Move a file, unchanged, to a path that doesn't exist yet.",
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "move"
                  }
                },
                "required": [
                  "op",
                  "from",
                  "to"
                ]
              },
              {
                "description": "Delete a file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "delete"
                  }
                },
                "required": [
                  "op",
                  "path"
                ]
              }
            ]
          },
          "Splice": {
            "type": "object",
            "properties": {
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ]
          },
          "Warning": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "message"
            ]
          }
        }
      }
    },
