    },
    {
      "name": "search",
      "kind": "query",
      "description": "Full-text search: plain terms, \"quoted phrases\" and prefix* (all must match).",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "SearchInput",
        "description": "Full-text search over Pages.",
        "type": "object",
        "properties": {
          "text": {
            "description": "Plain terms (all must match), `\"quoted phrases\"`, and `prefix*`.",
            "type": "string"
          },
          "filter": {
            "$ref": "#/$defs/Filter"
          },
          "limit": {
            "description": "At most this many (default 100).",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          },
          "offset": {
            "description": "Skip this many first.",
            "type": [
              "integer",
              "null"
            ],
            "format": "uint32",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "$defs": {
          "Filter": {
            "description": "Which Pages a query covers (operations.md `Filter`).",
            "type": "object",
            "properties": {
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "tag": {
                "description": "Only Pages carrying this Tag or, unless `exact`, one of its descendants.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "exact": {
                "description": "With `tag`: only the Tag itself, not its descendants.",
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "SearchOutput",
        "type": "object",
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Hit"
            }
          },
          "total": {
            "description": "Matching Pages before `limit` / `offset`.",
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "hits",
          "total"
        ],
        "$defs": {
          "Hit": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "snippet": {
                "description": "Matching text with matches wrapped in `**`.",
                "type": "string"
              },
              "score": {
                "description": "Relevance; higher is better.",
                "type": "number",
                "format": "double"
              }
            },
            "required": [
              "path",
              "title",
              "snippet",
              "score"
            ]
          }
        }
      }
    },
    {
      "name": "index_status",
      "kind": "query",
      "description": "Report on the Index: counts, freshness, skipped files, unrecovered edits.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "IndexStatusInput",
        "description": "Report on the Index.",
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "IndexStatusOutput",
        "type": "object",
        "properties": {
          "root": {
            "description": "The Wiki root this process resolved.",
            "type": "string"
          },
          "cache_dir": {
            "description": "Per-Wiki cache dir (Index, write lock, journal).",
            "type": "string"
          },
          "pages": {
            "type": "integer",
            "format": "int64"
          },
          "attachments": {
            "type": "integer",
            "format": "int64"
          },
          "links": {
            "description": "Links written in Pages (resolved or not).",
            "type": "integer",
            "format": "int64"
          },
          "tags": {
            "description": "Distinct Tags.",
            "type": "integer",
            "format": "int64"
          },
          "last_updated": {
            "description": "When the Index last changed, milliseconds since the Unix epoch.",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "stale": {
            "description": "Whether the Index may be behind the files (always false right after open).",
            "type": "boolean"
          },
          "watcher": {
            "description": "File watching in this handle: `native`, `poll`, or `none` (one-shot CLI calls).",
            "type": "string"
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Skipped"
            }
          },
          "unrecovered_edits": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/UnrecoveredEdit"
            }
          }
        },
        "required": [
          "root",
          "cache_dir",
          "pages",
          "attachments",
          "links",
          "tags",
          "stale",
          "watcher",
          "skipped",
          "unrecovered_edits"
        ],
        "$defs": {
          "Skipped": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "description": "`symlink`, `non_utf8` or `case_clash`.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "reason"
            ]
          },
          "UnrecoveredEdit": {
            "description": "An edit from a crashed Plan that recovery left alone because its file had\nchanged in the meantime. Reported by `index_status` and `check`.",
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "edit": {
                "$ref": "#/$defs/Edit"
              }
            },
            "required": [
              "path",
              "edit"
            ]
          },
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ]
              },
              {
                "description": "Create a new file with binary content (an Attachment). The bytes are\nstaged in the cache dir, not carried in the Plan.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "version": {
                    "description": "Hash of the content, as a `Version`.",
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create_binary"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "size",
                  "version"
                ]
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    }
                  },
                  "op": {
                    "type": "string",
                    "const": "modify"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ]
              },
              {
                "description": "Move a file, unchanged, to a path that doesn't exist yet.",
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "move"
                  }
                },
                "required": [
                  "op",
                  "from",
                  "to"
                ]
              },
              {
                "description": "Delete a file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "delete"
                  }
                },
                "required": [
                  "op",
                  "path"
                ]
              }
            ]
          },
          "Splice": {
            "type": "object",
            "properties": {
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ]
          }
        }
      }
    },
    {
      "name": "rebuild_index",
      "kind": "maintenance",
      "description": "Drop the Index and rebuild it from the files. Changes no Wiki file.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "RebuildIndexInput",
        "description": "Drop the Index and rebuild it from the files.",
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "IndexStatusOutput",
        "type": "object",
        "properties": {
          "root": {
            "description": "The Wiki root this process resolved.",
            "type": "string"
          },
          "cache_dir": {
            "description": "Per-Wiki cache dir (Index, write lock, journal).",
            "type": "string"
          },
          "pages": {
            "type": "integer",
            "format": "int64"
          },
          "attachments": {
            "type": "integer",
            "format": "int64"
          },
          "links": {
            "description": "Links written in Pages (resolved or not).",
            "type": "integer",
            "format": "int64"
          },
          "tags": {
            "description": "Distinct Tags.",
            "type": "integer",
            "format": "int64"
          },
          "last_updated": {
            "description": "When the Index last changed, milliseconds since the Unix epoch.",
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "stale": {
            "description": "Whether the Index may be behind the files (always false right after open).",
            "type": "boolean"
          },
          "watcher": {
            "description": "File watching in this handle: `native`, `poll`, or `none` (one-shot CLI calls).",
            "type": "string"
          },
          "skipped": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Skipped"
            }
          },
          "unrecovered_edits": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/UnrecoveredEdit"
            }
          }
        },
        "required": [
          "root",
          "cache_dir",
          "pages",
          "attachments",
          "links",
          "tags",
          "stale",
          "watcher",
          "skipped",
          "unrecovered_edits"
        ],
        "$defs": {
          "Skipped": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "description": "`symlink`, `non_utf8` or `case_clash`.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "reason"
            ]
          },
          "UnrecoveredEdit": {
            "description": "An edit from a crashed Plan that recovery left alone because its file had\nchanged in the meantime. Reported by `index_status` and `check`.",
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "edit": {
                "$ref": "#/$defs/Edit"
              }
            },
            "required": [
              "path",
              "edit"
            ]
          },
          "Edit": {
            "description": "One file edit. Paths are relative to the Wiki root.",
            "oneOf": [
              {
                "description": "Create a new file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ]
              },
              {
                "description": "Create a new file with binary content (an Attachment). The bytes are\nstaged in the cache dir, not carried in the Plan.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "version": {
                    "description": "Hash of the content, as a `Version`.",
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "create_binary"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "size",
                  "version"
                ]
              },
              {
                "description": "Splice an existing file. Every byte outside the splices is unchanged.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "base_version": {
                    "description": "Hash of the file this edit was planned against.",
                    "type": "string"
                  },
                  "splices": {
                    "description": "Non-overlapping byte ranges of the original file, in order.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/Splice"
                    }
                  },
                  "op": {
                    "type": "string",
                    "const": "modify"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "base_version",
                  "splices"
                ]
              },
              {
                "description": "Move a file, unchanged, to a path that doesn't exist yet.",
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string"
                  },
                  "to": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "move"
                  }
                },
                "required": [
                  "op",
                  "from",
                  "to"
                ]
              },
              {
                "description": "Delete a file.",
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "const": "delete"
                  }
                },
                "required": [
                  "op",
                  "path"
                ]
              }
            ]
          },
          "Splice": {
            "type": "object",
            "properties": {
              "range": {
                "description": "Byte range `[start, end)` in the original file.",
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint",
                  "minimum": 0
                },
                "minItems": 2,
                "maxItems": 2
              },
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              }
            },
            "required": [
              "range",
              "old",
              "new"
            ]
          }
        }
      }
    },
    {
      "name": "watch",
      "kind": "subscription",
      "description": "Stream change events (Pages, Attachments, the Index) as they happen, from this process and every other writer.",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "WatchInput",
        "description": "Stream change events for the Wiki, or a part of it.",
        "type": "object",
        "properties": {
          "scope": {
            "description": "Only changes in this part of the Wiki.",
            "$ref": "#/$defs/Scope"
          }
        },
        "additionalProperties": false,
        "$defs": {
          "Scope": {
            "description": "Which part of the Wiki a query covers (operations.md `Scope`).",
            "type": "object",
            "properties": {
              "space": {
                "description": "Only this Space: its home Page and everything under it.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "path_prefix": {
                "description": "Only Pages whose Page Path starts with this.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "WatchEvent",
        "description": "One change. Events carry no content: call `get_page` for it.",
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/$defs/EventKind"
          },
          "path": {
            "description": "Page Path for Page events, Attachment path for `attachment_changed`;\nabsent for `index_updated`.",
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "description": "The old path of a move made by a wikirs Plan.",
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "description": "The file's new `Version`; absent once it's gone.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "$defs": {
          "EventKind": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "page_created",
                  "page_modified",
                  "page_deleted",
                  "attachment_changed"
                ]
              },
              {
                "description": "Only for moves made by a wikirs Plan; other moves are a delete and a create.",
                "type": "string",
                "const": "page_moved"
              },
              {
                "description": "The Index took in a batch of changes: sent once, after the batch's events.",
                "type": "string",
                "const": "index_updated"
              }
            ]
          }
        }
      }
    }
  ]
}
